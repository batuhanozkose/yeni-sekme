# Only needed for the Bun harness in harness/. The extension asks for these in its UI.
# Which provider to build against: anthropic (default) | openai | openrouter | groq | ollama | custom
HOMEPAGE_PROVIDER=anthropic
# Model id. Defaults to the provider's first suggestion; required for the others.
HOMEPAGE_MODEL=
# Override the endpoint, for a self-hosted or local server.
HOMEPAGE_BASE_URL=
# Page language: en (default) | tr
HOMEPAGE_LANGUAGE=en
# Standing instructions for harness runs (same as the extension's Settings box)
HOMEPAGE_PROMPT=

# The key for the provider above. Pick the one that matches HOMEPAGE_PROVIDER.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Ollama needs no key at all.
